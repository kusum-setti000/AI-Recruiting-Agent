import sys
import logging
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

import streamlit as st

from app.agents.document_loader import ResumeValidationError
from app.integrations.job_discovery.resume_profiler import profile_from_resume
from app.integrations.job_discovery.service import JobDiscoveryService

logger = logging.getLogger(__name__)

st.set_page_config(page_title="AI Job Discovery", layout="wide")
st.title("AI Job Discovery")
st.write("Upload your resume to discover matching jobs.")

with st.form("discovery_form"):
    resume = st.file_uploader("Resume", type=["pdf", "docx"])
    location = st.text_input("Location", value="United States")
    remote_only = st.checkbox("Remote only")
    submitted = st.form_submit_button("Find matching jobs", type="primary")

if submitted:
    st.session_state.pop("discovery_jobs", None)
    st.session_state.pop("discovery_profile", None)

    if resume is None:
        st.error("Please upload a resume.")
    else:
        try:
            with st.spinner("Analyzing resume and searching jobs..."):
                profile = profile_from_resume(
                    filename=resume.name,
                    file_bytes=resume.getvalue(),
                    location=location.strip() or None,
                    remote_only=remote_only,
                )
                result = JobDiscoveryService().search(profile)

            st.session_state["discovery_profile"] = profile.model_dump()
            st.session_state["discovery_jobs"] = [
                job.model_dump(mode="json") for job in result.jobs
            ]
        except (ResumeValidationError, ValueError) as exc:
            st.error(str(exc))
        except Exception:
            logger.exception("Job discovery failed")
            st.error("Job discovery failed. See terminal traceback.")

jobs = st.session_state.get("discovery_jobs")
profile = st.session_state.get("discovery_profile")

if jobs is not None:
    st.metric("Jobs found", len(jobs))

    with st.expander("Extracted resume profile"):
        st.json(profile)

    search = st.text_input("Search jobs by title, company, or location")
    min_score = st.slider("Minimum match score", 0, 100, 0)

    filtered = [
        job for job in jobs
        if (job.get("match_score") or 0) >= min_score
        and search.lower() in " ".join(
            str(job.get(field) or "")
            for field in ("title", "company", "location")
        ).lower()
    ]

    st.caption(f"Showing {len(filtered)} of {len(jobs)} jobs")

    for job in filtered:
        with st.container(border=True):
            st.subheader(job.get("title") or "Untitled position")
            st.write(
                f"**{job.get('company') or 'Unknown company'}** "
                f"- {job.get('location') or 'Location not specified'}"
            )
            score = job.get("match_score")
            st.metric("Match score", f"{score}%" if score is not None else "N/A")

            if job.get("recommendation_summary"):
                st.write(job["recommendation_summary"])

            details = job.get("match_explanation") or {}
            if details.get("matched_skills"):
                st.write("Matched skills:", ", ".join(details["matched_skills"]))

            with st.expander("Match explanation"):
                st.json(details)

            url = str(job.get("job_url") or "")
            if url.startswith("https://"):
                st.link_button("View job / Apply", url)

    if not filtered:
        st.info("No matching jobs for these filters.")
